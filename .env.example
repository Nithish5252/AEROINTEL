# AeroIntel Configuration (Demo Mode by default - no credentials required)
AEROINTEL_ENV=development
AEROINTEL_DEMO_MODE=true

# Optional: OpenSky Network API Credentials (Leave empty for synthetic demo mode)
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# Anomaly Detection Demonstration Thresholds (Adjustable in UI as well)
AEROINTEL_VERTICAL_RATE_THRESHOLD_FPM=3000
AEROINTEL_SPEED_CHANGE_THRESHOLD_KT=45
AEROINTEL_STALE_TELEMETRY_THRESHOLD_SEC=180
